[Unit]
Description=GLIVARAO daily research + production (1 long + 2 Shorts) -> Telegram review. Never uploads.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=glivarao
WorkingDirectory=/opt/glivarao/app
ExecStart=/opt/glivarao/app/.venv/bin/python -m glivarao -v daily-v2
StandardOutput=append:/opt/glivarao/app/logs/daily.log
StandardError=append:/opt/glivarao/app/logs/daily.log
TimeoutStartSec=4h
Nice=5
NoNewPrivileges=true
PrivateTmp=true
