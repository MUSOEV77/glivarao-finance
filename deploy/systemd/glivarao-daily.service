[Unit]
Description=GLIVARAO daily production (long video when due + 3 Shorts) -> Telegram review. Never uploads.
After=network-online.target
Wants=network-online.target

OnFailure=glivarao-alert@%n.service
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
User=glivarao
WorkingDirectory=/opt/glivarao/app
ExecStart=/opt/glivarao/app/.venv/bin/python -m glivarao -v daily-v2
StandardOutput=append:/opt/glivarao/app/logs/daily.log
StandardError=append:/opt/glivarao/app/logs/daily.log
TimeoutStartSec=4h
Nice=5
Restart=on-failure
RestartSec=15min
NoNewPrivileges=true
PrivateTmp=true
