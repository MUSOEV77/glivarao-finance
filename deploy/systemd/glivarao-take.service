[Unit]
Description=GLIVARAO: ask for your take on tomorrow's long video (Telegram). Never uploads.
After=network-online.target
OnFailure=glivarao-alert@%n.service
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
User=glivarao
WorkingDirectory=/opt/glivarao/app
ExecStart=/opt/glivarao/app/.venv/bin/python -m glivarao ask-take
NoNewPrivileges=true
PrivateTmp=true
