[Unit]
Description=GLIVARAO: competitor research (YouTube Data API, read-only)
After=network-online.target
Wants=network-online.target
OnFailure=glivarao-alert@%n.service
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
User=glivarao
WorkingDirectory=/opt/glivarao/app
ExecStart=/opt/glivarao/app/.venv/bin/python -m glivarao competitors
StandardOutput=append:/opt/glivarao/app/logs/competitors.log
StandardError=append:/opt/glivarao/app/logs/competitors.log
TimeoutStartSec=30min
Restart=on-failure
RestartSec=15min
NoNewPrivileges=true
PrivateTmp=true
