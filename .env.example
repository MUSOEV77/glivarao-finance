# Copy to .env and fill in. NEVER commit .env. All values are read from the environment.

# ---- Run mode -------------------------------------------------------------
# dry-run: offline script generator + placeholder voice, no network calls.
GLIVARAO_MODE=dry-run            # dry-run | production
GLIVARAO_OUTPUT_DIR=output
GLIVARAO_DB_PATH=data/glivarao.sqlite3
GLIVARAO_FPS=12                  # animation frame rate ("on twos" hand-drawn look); encoded at 30
GLIVARAO_TIMEZONE=America/New_York

# ---- Script generation (Anthropic Claude API) ------------------------------
ANTHROPIC_API_KEY=
GLIVARAO_SCRIPT_MODEL=claude-opus-5-5

# ---- Narration (American English male voice) -------------------------------
# Provider: kokoro (local neural voice, free, recommended) | elevenlabs | google
#           espeak / silent are development placeholders and are REFUSED in production mode.
TTS_PROVIDER=espeak
KOKORO_VOICE=am_michael          # US-English male; alternatives: am_fenrir, am_puck
GLIVARAO_RENDERER=v1             # v2 = new animated renderer (rigged characters, camera, transitions)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=             # pick a US-English male voice you are licensed to use
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-US-Neural2-D # US-English male

# ---- Market data (optional, for real charts) -------------------------------
FRED_API_KEY=

# ---- Telegram approval -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_ID=       # numeric chat id of the approver (only this chat may approve)
TELEGRAM_API_BASE=https://api.telegram.org   # or http://127.0.0.1:8081 for a self-hosted Bot API server
TELEGRAM_MAX_UPLOAD_MB=50        # 50 for the cloud Bot API; up to 2000 with a self-hosted server

# ---- YouTube ---------------------------------------------------------------
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
YOUTUBE_PUBLISH_ENABLED=false    # hard kill-switch; even when true, uploads are manual,
                                 # interactive and always PRIVATE (never public, never scheduled)
YOUTUBE_CATEGORY_ID=27           # Education
