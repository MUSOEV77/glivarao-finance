# Copy to .env and fill in. NEVER commit .env. All values are read from the environment.

# ---- Run mode -------------------------------------------------------------
# dry-run: offline script generator + placeholder voice, no network calls.
GLIVARAO_MODE=dry-run            # dry-run | production
GLIVARAO_OUTPUT_DIR=output
GLIVARAO_DB_PATH=data/glivarao.sqlite3
GLIVARAO_FPS=12                  # animation frame rate ("on twos" hand-drawn look); encoded at 30

# ---- Script generation (Anthropic Claude API) ------------------------------
ALLOW_PAID_APIS=false            # must be "true" (owner approval) before any paid API (Claude) is called
ANTHROPIC_API_KEY=
GLIVARAO_SCRIPT_MODEL=claude-opus-5-5
CLAUDE_MONTHLY_BUDGET_USD=30     # hard cap in code, checked before every Claude request (also set a Console limit)
CLAUDE_PRICE_IN_PER_M=4          # Claude Opus 5.5 list price, USD per 1M input tokens
CLAUDE_PRICE_OUT_PER_M=20        # ... per 1M output tokens

# ---- Narration (American English male voice) -------------------------------
# Provider: gemini_tts (THE channel voice, locked) | kokoro (development only)
#           | google_chirp (Chirp 3 HD, alternative) | elevenlabs | google
#           espeak / silent are development placeholders and are REFUSED in production mode.
# ---- Channel voice: LOCKED to Gemini TTS "Charon" (no fallback voice; see docs/VOICE.md)
TTS_PROVIDER=gemini_tts
KOKORO_VOICE=am_michael          # development/testing only; never used for channel videos
                                 # Paid voices (elevenlabs/google) are refused unless ALLOW_PAID_APIS=true
GLIVARAO_RENDERER=v1             # v2 = new animated renderer (rigged characters, camera, transitions)
GLIVARAO_THEME=editorial         # daily-v2 look: editorial (premium documentary, default) | cartoon
# RENDER_WORKERS=2               # optional fixed worker count; default = min(CPUs, free RAM / 1 GB)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=             # pick a US-English male voice you are licensed to use
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
GEMINI_API_KEY=                  # Gemini API key on a billing-enabled (paid tier) Google Cloud project
GEMINI_TTS_MODEL=gemini-3.8-flash-tts   # pinned stable model ID ("latest"/"preview"/"exp" names are refused)
GEMINI_TTS_VOICE=Charon
GEMINI_TTS_PACE=measured         # energetic | measured | slow | brisk (part of the style prompt)
GEMINI_TTS_SPEED=1.0             # pitch-preserving tempo after synthesis; set by the voice audition (e.g. 1.08)
TTS_TARGET_WPM=170               # narrator pace target (165-175 words per minute); scripts are sized for it
# GEMINI_TTS_STYLE=...           # the narrator direction; default: warm, deep, confident documentary narrator
# Changing MODEL, VOICE, PACE or STYLE later holds all videos until you run: python -m glivarao voice-lock --reset
GEMINI_TTS_RETRIES=5             # temporary errors: retry with backoff 5, 10, 20, 40, 80 s; then the video is held
GEMINI_TTS_BACKOFF_SEC=5
GEMINI_TTS_PRICE_PER_M_AUDIO=18  # conservative (reported 2027 rate); 2026 list rate reported at $9
GEMINI_TTS_TOKENS_PER_SEC=32     # conservative; Google states 25
TTS_ALERT_RATIO=0.8              # Telegram alert at 80% of TTS_MONTHLY_BUDGET_USD
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-US-Chirp3-HD-Charon   # Chirp 3 HD candidates: Charon, Orus, Algenib, Sadaltager
GOOGLE_TTS_RATE=1.0
# Voice hard cap per calendar month (needs ALLOW_PAID_APIS=true). At the cap, videos are held until next month.
TTS_MONTHLY_BUDGET_USD=20
TTS_PRICE_PER_MILLION=30
TTS_FREE_CHARS_PER_MONTH=0       # set 1000000 only after confirming Google's free tier on your billing account

# ---- Your involvement and pace (see docs/AUTHENTICITY.md) -------------------
TOPIC_MODE=auto                  # auto = research picks topics (default); queue = you pick from weekly ideas
CREATOR_INPUT_WAIT_HOURS=4      # auto mode: how long to wait for your optional take before producing
REQUIRE_CREATOR_INPUT=true       # queue mode only: no video without your take (auto mode uses the wait above)
LONG_VIDEOS_PER_MONTH=16         # spread evenly through the month
MIN_DAYS_BETWEEN_LONG=1
SHORTS_PER_DAY=3                 # 3 x 30 days = 90 Shorts a month (own topic on days without a long video)
TOPIC_IDEAS_PER_WEEK=6           # 5-7 ideas every Sunday
SIMILARITY_MAX_PHRASE=0.25       # anti-repetition: share of 8-word phrases already used
SIMILARITY_MAX_STRUCTURE=0.85

# ---- Upload pack (after you approve; you upload and schedule in the YouTube Studio app yourself)
PUBLISH_TIMES_LONG_WEEKDAY=14:00 # New York time
PUBLISH_TIMES_LONG_WEEKEND=11:00
PUBLISH_TIMES_SHORTS=11:00,15:00,19:30
PUBLISH_LEAD_HOURS=2             # earliest suggested slot after approval
# AFFILIATE_DISCLOSURE=...       # text added to every description (default: standard affiliate disclosure)

# ---- Market data (optional, for real charts) -------------------------------
FRED_API_KEY=

# ---- Telegram approval -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_ID=       # numeric chat id of the approver (only this chat may approve)
TELEGRAM_API_BASE=https://api.telegram.org   # or http://127.0.0.1:8081 for a self-hosted Bot API server
TELEGRAM_MAX_UPLOAD_MB=50        # 50 cloud; 1900 with the local Bot API server (deploy/telegram-local-api.sh)

# ---- YouTube ---------------------------------------------------------------
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
YOUTUBE_PUBLISH_ENABLED=false    # hard kill-switch; even when true, uploads are manual,
                                 # interactive and always PRIVATE (never public, never scheduled)
YOUTUBE_CATEGORY_ID=27           # Education

# ---- Buffer and pace (2 approved long + 6 Shorts ready; produced 2-3 days ahead)
BUFFER_LONG=2
BUFFER_SHORTS=6
PRODUCTION_LEAD_DAYS=3
SHORTS_PER_MONTH=90

# ---- Your time zone and quiet hours (no Telegram messages; delivered at QUIET_END)
LOCAL_TZ=Asia/Tashkent
QUIET_START=23:00
QUIET_END=08:00

# ---- Stability alerts
SPEND_ALERT_RATIO=0.8            # alert at 80% of the Claude and voice monthly caps
DISK_ALERT_GB=10

# ---- Competitor research (YouTube Data API, read-only; put the key in with deploy/set-key.sh)
YOUTUBE_API_KEY=
COMPETITOR_CHANNELS=Casual Finance,How Money Works,Economics Explained,Money & Macro,The Plain Bagel,Two Cents
COMPETITOR_DAYS=90

# ---- AI images: Nano Banana 2.1 (same GEMINI_API_KEY; long videos only; code-drawn visuals if anything fails)
IMAGE_PROVIDER=gemini            # gemini | none
IMAGE_MODEL=gemini-nano-banana-2.1   # pinned stable model ID ("latest"/"preview" refused)
IMAGE_MONTHLY_BUDGET_USD=15      # separate cap; Telegram alert at 80% (SPEND_ALERT_RATIO)
IMAGE_PRICE_1K=0.0336            # reported Gemini API price per image (Oct 2026); check Google's pricing page
IMAGE_PRICE_2K=0.0504
IMAGE_SCENE_SIZE=1K              # scene illustrations
IMAGE_THUMB_SIZE=2K              # thumbnails (3 options per long video)
IMAGE_SCENES_MAX=20              # 10-20 per long video (one per scene, spread evenly)

# ---- Script writer: Claude on Vertex AI (default) with automatic Gemini Pro fallback (docs/VERTEX_CLAUDE.md)
WRITER=claude_vertex             # claude_vertex | claude_api (Anthropic Console key) | free (templates only)
VERTEX_PROJECT_ID=               # set by deploy/set-vertex-key.sh from your key
VERTEX_REGION=global
VERTEX_MODEL=claude-sonnet-5-5
VERTEX_CREDENTIALS_FILE=secrets/vertex-sa.json   # owner-only file, never in Git
VERTEX_PRICE_IN_PER_M=2          # Claude Sonnet 5.5 (check Vertex AI pricing once)
VERTEX_PRICE_OUT_PER_M=10
GEMINI_WRITER_MODEL=gemini-3.1-pro-preview   # fallback writer; `doctor --live` lists the Pro models for your key
GEMINI_WRITER_PRICE_IN_PER_M=2
GEMINI_WRITER_PRICE_OUT_PER_M=12
GEMINI_WRITER_MONTHLY_BUDGET_USD=5
AI_STUDIO_LIMIT_USD=35           # your AI Studio spend limit (doctor warns if it's below the Gemini caps)

# ---- Claude only (default): no fallback writer. If Claude can't write, production is held, you get an alert,
# and it retries every hour. Set gemini to let Gemini Pro write instead.
WRITER_FALLBACK=none
# ---- Shorts length (40-55 s): script capped, real audio measured, re-voiced up to 2x, never sent over 60 s
SHORT_MAX_WORDS=110
SHORT_REDO_SECONDS=58
SHORT_TARGET_SECONDS=50
SHORT_MAX_SECONDS=60
